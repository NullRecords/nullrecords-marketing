# NullRecords AI Engine — Environment Variables
# Copy this file to .env and fill in your keys.

# --- AI provider routing ---
# AI_PROVIDER values:
#   local_first = try Ollama first, then OpenAI fallback when configured
#   local       = only try Ollama
#   openai      = only use OpenAI
#   none        = skip model calls and use deterministic fallbacks
AI_PROVIDER=local_first
LOCAL_AI_URLS=http://localhost:11434,http://alderaan.hoth:11434
LOCAL_AI_MODEL=llama3.1:8b
LOCAL_AI_TIMEOUT=20
OPENAI_FALLBACK_ENABLED=true

# --- OpenAI fallback ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Pexels ---
PEXELS_API_KEY=

# --- Spotify (for playlist discovery) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- YouTube (for channel discovery) ---
YOUTUBE_API_KEY=

# --- Label ---
LABEL_GENRE=nu jazz, experimental electronic
LABEL_NAME=NullRecords
